# Olist Analytics Studio - Environment Configuration
# Copy to .env and customize as needed

# Database
DATABASE_URL=postgresql://olist:olist_dev@localhost:5433/olist

# API
PORT=3000

# Agent mode: "llm" or "fallback"
AGENT_MODE=fallback

# LLM Provider (only needed for llm mode)
ANTHROPIC_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-4-20250514

# Timeouts (ms)
ANALYSIS_TIMEOUT_MS=45000
MODEL_TIMEOUT_MS=25000
TOOL_TIMEOUT_MS=5000
FALLBACK_TIMEOUT_MS=10000

# LLM bounds
MAX_MODEL_TURNS=4
MAX_TOOL_CALLS=8

# Row limits
MAX_CHART_ROWS=500
MAX_RANKED_DISPLAY=100
DEFAULT_RANKED_DISPLAY=10
MAX_REQUEST_LENGTH=2000
