{
  "name": "@olist/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./analysis": {
      "types": "./dist/analysis/index.d.ts",
      "import": "./dist/analysis/index.js"
    },
    "./analysis/insight-validator": {
      "types": "./dist/analysis/insight-validator.d.ts",
      "import": "./dist/analysis/insight-validator.js"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/adapter.d.ts",
      "import": "./dist/mcp/adapter.js"
    },
    "./mcp/mock-provider": {
      "types": "./dist/mcp/mock-provider.d.ts",
      "import": "./dist/mcp/mock-provider.js"
    },
    "./db/pool": {
      "types": "./dist/db/pool.d.ts",
      "import": "./dist/db/pool.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --import tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@fastify/static": "10.1.3",
    "@modelcontextprotocol/client": "2.0.0",
    "@olist/contracts": "workspace:*",
    "fastify": "5.12.3",
    "pg": "8.23.0",
    "uuid": "14.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/uuid": "11.0.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
